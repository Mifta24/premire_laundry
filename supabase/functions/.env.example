# Secrets untuk Supabase Edge Functions
# Set via: supabase secrets set KEY=value

# Firebase Admin SDK - dari Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste isi JSON-nya (satu baris, hilangkan newline)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"premier-laundry-dcef2","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@premier-laundry-dcef2.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Xendit Secret Key - dari Xendit Dashboard > Settings > API Keys (gunakan TEST key dulu)
XENDIT_SECRET_KEY=xnd_development_XXXXXXXXXXXX

# Xendit Webhook Token - dari Xendit Dashboard > Settings > Webhooks > Webhook Token
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token
